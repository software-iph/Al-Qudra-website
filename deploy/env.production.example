# Copy to /opt/alqudra/.env on the VPS and chmod 600. Never commit the real file.
# Values must not contain inline comments.

# Database (used by both containers)
DB_NAME=alqudra
DB_USER=alqudra
# Long random value, e.g. openssl rand -hex 24
DB_PASSWORD=

# Signs dashboard login cookies. Long random value, e.g. openssl rand -hex 32
SESSION_SECRET=

SITE_URL=https://www.alqudra-ec.com

# First dashboard user - created on first start only if no user exists yet.
# Use a real mailbox and a strong password, then blank these two lines and restart.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
